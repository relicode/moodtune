{
  "name": "moodtune",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Anssi Siren <pro@avaruus.mozmail.com>",
  "scripts": {
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp -r node_modules/pino-abstract-transport node_modules/process-warning node_modules/split2 .next/standalone/node_modules/",
    "dev": "next dev",
    "format": "concurrently --max-processes 1 --prefix-colors auto 'npm:format:eslint' 'npm:format:prettier'",
    "format:eslint": "eslint --fix",
    "format:prettier": "prettier --write 'src/**' '__tests__/**/*.ts' 'scripts/**/*.ts' '*.{ts,mjs,json,md,yaml}'",
    "lint": "eslint",
    "lint:eslint": "eslint",
    "lint:prettier": "prettier --check 'src/**' '__tests__/**/*.ts' 'scripts/**/*.ts' '*.{ts,mjs,json,md,yaml}'",
    "lint:typescript": "tsc --noEmit",
    "db:delete": "tsx scripts/reset.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "npm run db:delete && npm run db:seed",
    "show-redis": "tsx scripts/show-redis.ts",
    "start": "node .next/standalone/server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "postinstall": "sh scripts/postinstall.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/material-nextjs": "^7.3.8",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.9.3",
    "jose": "^6.1.3",
    "lodash-es": "^4.17.23",
    "material-ui-confirm": "^4.0.0",
    "minio": "^8.0.6",
    "next": "16.1.6",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@img/sharp-linuxmusl-arm64": "^0.34.5"
  }
}
