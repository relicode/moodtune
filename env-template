# Copy to .env

# --- Redis ---
REDIS_URL=redis://localhost:6379 # Redis connection URL (overridden to redis://redis:6379 in Docker Compose)

# --- MinIO ---
MINIO_ENDPOINT=localhost # MinIO hostname (overridden to 'minio' in Docker Compose)
MINIO_PORT=9000 # MinIO API port
MINIO_ACCESS_KEY=minioadmin # MinIO access key
MINIO_SECRET_KEY=minioadmin # MinIO secret key
MINIO_USE_SSL=false # MinIO TLS enabled
MINIO_BUCKET=moodtune # Bucket name prefix (images bucket is {MINIO_BUCKET}-images)

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret # Secret key for signing JWT session tokens
ADMIN_USERNAME=admin # Default admin username created by db:seed
ADMIN_PASSWORD=admin # Default admin password created by db:seed

# --- Uploads ---
# UPLOAD_TMP_DIR=/var/tmp # Directory for temporary upload files (defaults to /var/tmp)

# --- Build ---
# NPM_CONFIG_REGISTRY=https://verdaccio.moisad.info/ # Private npm registry (optional, used during Docker build)

